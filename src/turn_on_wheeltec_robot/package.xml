<?xml version="1.0"?>
<package format="3">
  <name>turn_on_wheeltec_robot</name>
  <version>2.0.0</version>
  <description>Mini ROS 小车的 ROS2 底盘串口桥接、机器人模型与 RTAB-Map/Nav2 启动包。</description>

  <maintainer email="wheeltec@todo.todo">wheeltec</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
