# 在树莓派与 Windows 间保持源文件使用 LF 行尾，减少无意义的版本差异。
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
# shell 脚本必须为 LF：Windows 上若检出为 CRLF，目标机执行会报解释器错误
*.sh text eol=lf
*.xml text eol=lf
*.launch text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 保持厂商驱动及其 SDK 的原始格式，避免检出时产生大规模无意义行尾差异。
src/astra_camera/** -text
src/astra_camera_msgs/** -text
src/rplidar_ros/** -text
